# pw-mpris-visualcard -- systemd user service (template file)
#
# This file contains two placeholders; copied as is into ~/.config/systemd/user/ it cannot start:
#   @REPO@  absolute path of the repository (used by WorkingDirectory / Documentation / ExecStart)
#   @ARGS@  start arguments
#
# Use `make install-service` to render and install it into ~/.config/systemd/user/:
#   make install-service                                   # default arguments
#   make install-service SERVICE_ARGS="--size 360x360"     # override start arguments
#   make uninstall-service                                 # uninstall
#
# Manual installation is possible too: replace the two placeholders with real values first. Left
# unreplaced, systemd rejects the unit at load time as a fatal configuration error:
#   WorkingDirectory= path is not absolute: @REPO@
#   Unit configuration has fatal error, unit will not be started.

[Unit]
Description=pw-mpris-visualcard — render the playing track as a PipeWire video node
Documentation=file://@REPO@/README.md
Documentation=file://@REPO@/README.zh-CN.md
After=default.target

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
# --node must match the name selected in the OBS "PipeWire Video" source.
# --size is the output size, written as WxH. The whole layout scales proportionally by height;
#   width only decides the left/right padding.
#   To scale up, multiply both numbers: keeping W:H = 2:3 keeps the padding at 4%.
#     Common steps on an OBS 1080p canvas (height = absolute card height):
#       360x540  -> 50% of canvas height   CPU ~ 3.6%
#       400x600  -> 56% of canvas height   CPU ~ 4.2%
#       460x690  -> 64% of canvas height   CPU ~ 5.5%   <- default
#       480x720  -> 67% of canvas height   CPU ~ 6.3%
#   All of the above include the spinning cover. Turning the spin off (--spin 0) cuts the
#   per-frame cost by roughly another 60%.
#   A square canvas (e.g. 540x540) necessarily leaves a large horizontal gap: the round cover is
#   capped by the vertical budget, so width is naturally in surplus.
#   Set the OBS source's width/height to match this, so the output is 1:1 and not scaled.
# --fps is the frame-rate ceiling (default 30). CPU cost is roughly proportional to frame rate:
#   --fps 15 ~ half, --fps 10 ~ one third. The consumer may negotiate lower, never above this.
# --lyrics N shows N lines of synced lyrics (the current line is pinned to the first slot and
#   highlighted). 0 = off.
#   Lyrics come from MPRIS xesam:asText (LRC); if the player provides none there are none, and no
#   blank lines are shown.
#   Enabling lyrics shrinks the cover from 68vh to 54vh to make room.
# Note: this service sets PrivateTmp=yes, so --dump output lands in the service-private /tmp and
#   cannot be retrieved.
#   To tune the layout, run --dump directly in a terminal; do not put it here.
ExecStart=@REPO@/pw-mpris-visualcard-native @ARGS@
Restart=always
RestartSec=2

# Outputs video to PipeWire only; no additional capabilities are required
NoNewPrivileges=yes
PrivateTmp=no

[Install]
WantedBy=default.target
